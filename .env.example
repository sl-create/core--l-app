# Postgres connection string
DATABASE_URL="postgresql://ajo@localhost:5432/ajo"
# Direct connection for migrations. Locally, the same as DATABASE_URL. On Neon, the
# non-pooled connection string (the Vercel integration sets this for you).
DATABASE_URL_UNPOOLED="postgresql://ajo@localhost:5432/ajo"

# Stripe. Leave STRIPE_SECRET_KEY empty to run with simulated payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend. Required in production for sign-in links. In development,
# leave it empty: emails are printed to the server log and the sign-in link is
# shown on screen.
RESEND_API_KEY=""

# Private test deploys only: with no RESEND_API_KEY, anyone who enters this code on the
# sign-in form gets the link on screen and can sign in as any email. Leave empty for real use.
DEMO_ACCESS_CODE=""
EMAIL_FROM="Ajo <hello@example.com>"

# Comma-separated emails that become admins when they sign in
ADMIN_EMAILS=""

# Protects /api/cron/release-milestones (send as "Authorization: Bearer <secret>")
CRON_SECRET="change-me"

# Public URL, used in sign-in links, emails and Stripe return URLs. On Vercel it defaults
# to the project's production URL.
APP_URL="http://localhost:3000"
