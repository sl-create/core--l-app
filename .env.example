# Postgres connection string
DATABASE_URL="postgresql://ajo@localhost:5432/ajo"

# Stripe. Leave STRIPE_SECRET_KEY empty to run with simulated payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend. Required in production for sign-in links. In development,
# leave it empty: emails are printed to the server log and the sign-in link is
# shown on screen.
RESEND_API_KEY=""
EMAIL_FROM="Ajo <hello@example.com>"

# Protects /api/cron/release-milestones (send as "Authorization: Bearer <secret>")
CRON_SECRET="change-me"

# Public URL, used in sign-in links, emails and Stripe return URLs
APP_URL="http://localhost:3000"
