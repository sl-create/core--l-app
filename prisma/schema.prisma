generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum values mirror the string unions in src/lib/domain.

enum Location {
  LAGOS
  LONDON
  NEW_YORK
}

enum TrustTier {
  UNVERIFIED
  ID_VERIFIED
}

enum TravellerLevel {
  ARINRIN_AJO // Arìnrìn-àjò, Traveller
  OLOOOTO // Olóòótọ́, The Faithful One
  ATONA // Atọ́nà, Guide
  AGBA // Àgbà, Elder
}

enum Proposer {
  SENDER // sender asked a traveller
  TRAVELLER // traveller offered from their request feed
}

enum DocumentType {
  BIRTH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  NIN_SLIP
  UNIVERSITY_CERTIFICATE
  TRANSCRIPT
  OTHER
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum TripStatus {
  OPEN
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  OPEN
  BOOKED
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  PROPOSED // sender asked, traveller has not answered
  DECLINED
  ACCEPTED // traveller agreed, waiting for the sender to pay
  FUNDED // payment is held in escrow
  COMPLETED // every milestone confirmed and paid out
  CANCELLED
  DISPUTED
}

enum MilestoneType {
  PICKED_UP
  ARRIVED
  DELIVERED
}

enum Role {
  USER
  ADMIN
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeOutcome {
  RELEASED_TO_TRAVELLER // claim upheld, the milestone is paid and the journey continues
  REFUNDED_TO_SENDER // escrow still held goes back to the sender, and the booking ends
}

enum MessageKind {
  USER // written by the sender or traveller
  SYSTEM // automatic update about the booking
  SUPPORT // written by an Ajo admin
}

enum MilestoneStatus {
  PENDING
  CLAIMED // traveller says it happened, claim window running
  CONFIRMED // sender confirmed, or the claim window lapsed
  DISPUTED
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  trustTier              TrustTier @default(UNVERIFIED)
  kycSessionId           String?
  stripeAccountId        String? // Connect account that receives traveller payouts
  // Traveller track record, from which the level is computed (src/lib/domain/levels.ts)
  completedDeliveries    Int       @default(0)
  onTimeDeliveries       Int       @default(0)
  ratingCount            Int       @default(0)
  ratingSum              Int       @default(0)
  upheldDisputes         Int       @default(0)
  travellerCancellations Int       @default(0)
  elderApprovedAt        DateTime?
  role                   Role      @default(USER)
  suspendedAt            DateTime?
  createdAt              DateTime  @default(now())

  trips            Trip[]
  requests         DeliveryRequest[]
  disputesOpened   Dispute[]         @relation("DisputeOpenedBy")
  disputesResolved Dispute[]         @relation("DisputeResolvedBy")
  auditLogs        AuditLog[]
  messages         Message[]
  messageReads     MessageRead[]
  sessions         Session[]
  ratingsGiven     Rating[]          @relation("RatingRater")
  ratingsReceived  Rating[]          @relation("RatingTraveller")
}

model Trip {
  id                 String             @id @default(cuid())
  travellerId        String
  traveller          User               @relation(fields: [travellerId], references: [id])
  origin             Location
  destination        Location
  departureAt        DateTime
  arrivalAt          DateTime
  capacity           Int                @default(1)
  cancellationPolicy CancellationPolicy @default(MODERATE)
  notes              String?
  status             TripStatus         @default(OPEN)
  createdAt          DateTime           @default(now())

  bookings Booking[]

  @@index([origin, destination, departureAt])
}

model DeliveryRequest {
  id             String         @id @default(cuid())
  senderId       String
  sender         User           @relation(fields: [senderId], references: [id])
  documentType   DocumentType
  description    String?
  origin         Location
  destination    Location
  availableFrom  DateTime
  deadline       DateTime
  minLevel       TravellerLevel @default(ARINRIN_AJO)
  pickupCity     String
  recipientName  String
  recipientPhone String
  status         RequestStatus  @default(OPEN)
  createdAt      DateTime       @default(now())

  bookings Booking[]

  @@index([origin, destination, deadline])
}

model Booking {
  id         String          @id @default(cuid())
  requestId  String
  request    DeliveryRequest @relation(fields: [requestId], references: [id])
  tripId     String
  trip       Trip            @relation(fields: [tripId], references: [id])
  status     BookingStatus   @default(PROPOSED)
  proposedBy Proposer        @default(SENDER)

  // Price is locked when the sender proposes.
  currency           String
  urgency            String
  travellerPayout    Int
  serviceFee         Int
  total              Int
  cancellationPolicy CancellationPolicy

  paymentIntentId String? @unique
  transferGroup   String  @unique @default(cuid())
  refundedAmount  Int     @default(0)

  // Level bonus, paid by Ajo from its service fee when the delivery completes
  travellerLevel  TravellerLevel?
  levelBonus      Int             @default(0)
  bonusTransferId String?

  proposedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  fundedAt    DateTime?
  cancelledAt DateTime?
  cancelledBy String? // "SENDER" | "TRAVELLER"

  milestones Milestone[]
  disputes   Dispute[]
  messages   Message[]
  reads      MessageRead[]
  rating     Rating?

  @@index([tripId])
  @@index([requestId])
}

model Milestone {
  id             String          @id @default(cuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           MilestoneType
  sequence       Int
  payout         Int
  status         MilestoneStatus @default(PENDING)
  note           String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  confirmedAt    DateTime?
  transferId     String?
  disputes       Dispute[]

  @@unique([bookingId, type])
  @@index([status, claimExpiresAt])
}

model Dispute {
  id             String          @id @default(cuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id])
  milestoneId    String
  milestone      Milestone       @relation(fields: [milestoneId], references: [id])
  openedById     String
  openedBy       User            @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  reason         String
  status         DisputeStatus   @default(OPEN)
  outcome        DisputeOutcome?
  resolutionNote String?
  refundAmount   Int?
  resolvedById   String?
  resolvedBy     User?           @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, createdAt])
  @@index([bookingId])
}

/// Every admin action, kept for accountability. Never updated or deleted.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// One thread per booking, shared by the sender, the traveller and Ajo support.
model Message {
  id        String      @id @default(cuid())
  bookingId String
  booking   Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String? // null for system messages
  author    User?       @relation(fields: [authorId], references: [id])
  kind      MessageKind
  body      String
  createdAt DateTime    @default(now())

  @@index([bookingId, createdAt])
}

model MessageRead {
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lastReadAt DateTime

  @@id([bookingId, userId])
}

/// A single-use sign-in link. Only a hash of the token is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A signed-in browser. Deleting the row signs that browser out.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// The sender's rating of the traveller after a completed delivery.
model Rating {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raterId     String
  rater       User     @relation("RatingRater", fields: [raterId], references: [id])
  travellerId String
  traveller   User     @relation("RatingTraveller", fields: [travellerId], references: [id])
  score       Int // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())

  @@index([travellerId, createdAt])
}
